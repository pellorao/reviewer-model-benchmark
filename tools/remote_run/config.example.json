{
  "provider": "agy",
  "version_command": ["agy", "--version"],
  "command": [
    "agy", "-p", "Read the file {prompt_file} and do exactly what it says.",
    "--model", "gemini-4-{model}-{effort}",
    "--effort", "{effort}",
    "--output-format", "json",
    "--print-timeout", "60m",
    "--settings", "{file.settings.json}",
    "--add-dir", "{cwd}",
    "--sandbox"
  ],
  "files": {
    "settings.json": {
      "agentMode": "auto",
      "permissions": {
        "allow": [
          "read_file({cwd})", "read_file({prompt_file})", "write_file({report_dir})",
          "command(ls)", "command(cat)", "command(echo)", "command(wc)", "command(head)", "command(tail)", "command(grep)", "command(find)",
          "command(sort)", "command(diff)", "command(git status)", "command(git diff)", "command(git log)", "command(git show)"
        ],
        "deny": ["command(sudo)", "command(rm -rf)", "command(curl)", "command(wget)", "command(git push)", "write_file({cwd}/.git)"]
      }
    }
  },
  "env": {}
}
